{
  "manifest_version": 3,
  "name": "Slack Conversation Exporter",
  "version": "1.0.0",
  "description": "Extract your slack conversation history back to a chosen date.",
  "action": {
    "default_title": "Toggle Slack export panel",
    "default_icon": {
      "64": "icons/icon-64.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "html-export.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "slack-exporter@marcbresson"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}
