{
  "manifest_version": 3,
  "name": "Slack Conversation Exporter",
  "version": "1.0.0",
  "description": "Extract your slack conversation history back to a chosen date.",
  "action": {
    "default_title": "Toggle Slack export panel"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "html-export.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "slack-exporter@marcbresson"
    }
  }
}
